# Supabase Postgres transaction-pooler URI (server only)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres
# Server-only Supabase project URL used by CMS image uploads
SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# Server-only key used for authenticated blog image uploads
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_SCRYPT=SALT:HEX_HASH
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

COMPANY_EMAIL=support@zaraderagroup.com
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=Zaradera <support@your-verified-domain.com>
ENQUIRY_QUEUE_KEY=
CRON_SECRET=
NEXT_PUBLIC_LOAN_APP_URL=
